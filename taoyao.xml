<?xml version="1.0" encoding="UTF-8"?>
<!--
  Xiaomi 12 Lite (taoyao) for crDroid 16.0: local manifest.
  Goes to .repo/local_manifests/taoyao.xml (build_crdroid.sh init does that).

  Community trees: device/vendor from skglab-dev (lineage-23.2),
  hardware from Evolution X + swiitch-OFF-Lab, SEPolicy from LineageOS.
  Kernel: Meddax/taoyao-kernel (MeruLink — SukiSU-Ultra + XHID stealth).

  Remotes:
    crdroid  -> https://github.com/   (default for community trees)
    github   -> https://github.com/   (alias for direct GitHub projects)

  Pinned to reviewed commits. To follow a branch instead, replace the commit
  hash in revision with the branch name and drop upstream.
-->
<manifest>
  <!-- GitHub remote alias (same fetch base as crdroid) -->
  <remote name="github" fetch="https://github.com/" />

  <!-- Device tree -->
  <project path="device/xiaomi/taoyao" name="skglab-dev/device_xiaomi_taoyao" remote="crdroid"
           revision="2d0e252d4353f5310f2b1867288743ff2165afd1" upstream="lineage-23.2" />
  <project path="device/xiaomi/taoyao-camera" name="skglab-dev/device_xiaomi_taoyao-camera" remote="crdroid"
           revision="db9b5e9900a882b25b807bcf5819a7f5bd5dff6e" upstream="lineage-23.2" />

  <!-- Vendor blobs -->
  <project path="vendor/xiaomi/taoyao" name="skglab-dev/vendor_xiaomi_taoyao" remote="crdroid"
           revision="1bd905e6270e4da7b798c047d6688da0cc943515" upstream="lineage-23.2" />
  <project path="vendor/xiaomi/taoyao-camera" name="skglab-dev/vendor_xiaomi_taoyao-camera" remote="crdroid"
           revision="e4fec5aa06a4f5b31dce8ae0a060ebd2ac30068b" upstream="lineage-23.2" />

  <!-- Firmware: 17 images in Git LFS (~296 MiB); must match OS1.0.39.0.ULIEUXM on the phone -->
  <project path="vendor/xiaomi/taoyao-firmware" name="skglab-dev/vendor_xiaomi_taoyao-firmware" remote="crdroid"
           revision="3d62a6843b67ea74ad9cf36b33521ca9c84e33b4" upstream="lineage-23.2" />

  <!-- Hardware overlays -->
  <project path="hardware/xiaomi" name="Evolution-X-Devices/hardware_xiaomi" remote="crdroid"
           revision="8193a2d82379dca5a74eea5c3ccc76f077e85c59" upstream="bka-no-dsp" />
  <project path="hardware/dolby" name="swiitch-OFF-Lab/hardware_dolby" remote="crdroid"
           revision="69b571078f3f04d79584bdfe990b6fffa1c6b388" upstream="Dolby-Vision-2.0" />

  <!-- SEPolicy: SM7325 (holi) needs LineageOS SEPolicy vendor overlay -->
  <project path="device/qcom/sepolicy_vndr" name="LineageOS/android_device_qcom_sepolicy_vndr" remote="crdroid"
           revision="lineage-23.2" />

  <!-- Kernel: MeruLink (SukiSU-Ultra + XHID stealth) for taoyao -->
  <project name="Meddax/taoyao-kernel"
           path="kernel/xiaomi/sm7325"
           remote="github"
           revision="main" />
</manifest>
